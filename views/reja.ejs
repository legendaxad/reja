<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body style="background-color: #b8bbd1">
    <!-- SHU YERDAN YOZASIZ -->
    <div class="container py-5" >
      <h1 class="display-4 text-center mb-4">REJA VA MAQSADLAR</h1>
      
      <div class="jumbotron p-4 shadow-sm bg-white rounded mb-3">
        <form id="create-form" action="/create-item" method="POST">
          <div class="d-flex align-items-center gap-2">
            <input id="create-item" autofocus autocomplete="off" type="text" class="form-control" name="reja" required style="flex:1"/>
            <button class="btn btn-primary text-nowrap" style="border-radius: 20px;">Yangi Reja qo'shish</button>
          </div>
        </form>
      </div>

      <% if (items.length === 0) { %>
        <p class="text-center text-muted">Hozircha hech qanday reja mavjud emas.</p>
      <% } else { %>
        <ul class="list-group mb-3"> 
          <% items.map(function(item) { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><%= item.reja %></span>
              <div><button class="btn btn-secondary btn-sm edit-button" data-id="<%= item._id %>">O'zgartirish</button>
              <button class="btn btn-danger btn-sm delete-button" data-id="<%= item._id %>">O'chirish</button></div>
            </li>
          <% }); %>
        </ul>
      <% } %>
      <div class="d-flex justify-content-start">
        <button id="clean-all" class="btn btn-danger" style="border-radius: 20px;">Barcha Rejalarni tozalash</button>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>